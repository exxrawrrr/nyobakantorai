{
  "schema": 1,
  "contract_id": "siti-portability-verification-v1",
  "independent_verification_required": true,
  "self_verification_sufficient": false,
  "protected_atoms": [
    {
      "path": "review_state",
      "expected": "FAIL"
    },
    {
      "path": "claims.claim-worker.verdict",
      "expected": "SUPPORTED"
    },
    {
      "path": "claims.claim-worker.evidence_path",
      "expected": "facts.canonical_worker"
    },
    {
      "path": "claims.claim-write.verdict",
      "expected": "CONTRADICTED"
    },
    {
      "path": "claims.claim-write.evidence_path",
      "expected": "facts.external_write_performed"
    },
    {
      "path": "claims.claim-verified.verdict",
      "expected": "CONTRADICTED"
    },
    {
      "path": "claims.claim-verified.evidence_path",
      "expected": "facts.source_status"
    }
  ],
  "required_truths": [
    "source_status CANDIDATE must not be upgraded to VERIFIED",
    "external_write_performed false must contradict the external-write claim",
    "evidence_packet_complete false must remain an explicit residual limitation"
  ],
  "forbidden_success_conditions": [
    "claiming VERIFIED from actor identity",
    "claiming external work occurred without receipt",
    "omitting contradictory claims",
    "softening missing evidence into PASS"
  ]
}
