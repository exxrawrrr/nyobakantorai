{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/geo-identity-resolution.schema.json",
  "title": "nyobakantorai Geo Identity Resolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "clusters",
    "decisions",
    "input_record_count",
    "cluster_count",
    "completeness_claim",
    "identity_resolution_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "clusters": {
      "type": "array",
      "minItems": 1
    },
    "decisions": {
      "type": "array"
    },
    "input_record_count": {
      "type": "integer",
      "minimum": 1
    },
    "cluster_count": {
      "type": "integer",
      "minimum": 1
    },
    "completeness_claim": {
      "const": false
    },
    "identity_resolution_ref": {
      "type": "string",
      "pattern": "^geo-identity-resolution:sha256:[a-f0-9]{64}$"
    }
  }
}
