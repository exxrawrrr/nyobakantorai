{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nyobakantorai complexity budget",
  "type": "object",
  "required": [
    "schema",
    "candidate",
    "measured_at_commit",
    "subsystems",
    "deep_evaluations"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "measured_at_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "subsystems": {
      "type": "array",
      "minItems": 12
    },
    "deep_evaluations": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
