{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/mission-handoff-result.schema.json",
  "title": "nyobakantorai Mission Handoff Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "mission_id",
    "task_id",
    "employee_id",
    "state",
    "artifact_refs",
    "evidence_refs",
    "unknowns",
    "residual_risks",
    "receipt_ref",
    "error_category",
    "finished_at"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "employee_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "state": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "PARTIAL",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "unknowns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "residual_risks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "receipt_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^receipt:sha256:[a-f0-9]{64}$"
    },
    "error_category": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
