{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/capability-grant.schema.json",
  "title": "nyobakantorai Capability Resource Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grant_id",
    "employee_id",
    "capability_id",
    "access_modes",
    "actions",
    "targets",
    "issued_at",
    "expires_at",
    "evidence_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "grant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "employee_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "access_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "READ",
          "WRITE"
        ]
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_type",
          "resource_id"
        ],
        "properties": {
          "resource_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
