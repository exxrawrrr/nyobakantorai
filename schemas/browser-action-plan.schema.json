{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/browser-action-plan.schema.json",
  "title": "nyobakantorai Browser Action Plan v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "employee_id",
    "flow",
    "scope_ref",
    "allowed_origin",
    "ownership_evidence_ref",
    "scope_expires_at",
    "action",
    "connector_route_ref",
    "capability_route_ref",
    "approval_ref",
    "injection_signals",
    "content_trust",
    "decision",
    "reason",
    "allowed",
    "plan_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "flow": {
      "enum": [
        "PUBLIC_RESEARCH",
        "USER_OWNED_AUDIT",
        "LOCALHOST_QA"
      ]
    },
    "allowed": {
      "const": true
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^browser-action-plan:sha256:[a-f0-9]{64}$"
    },
    "ownership_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "allowed_origin": {
      "type": "string",
      "format": "uri"
    },
    "scope_ref": {
      "type": "string",
      "pattern": "^browser-scope:sha256:[a-f0-9]{64}$"
    },
    "connector_route_ref": {
      "type": "string",
      "pattern": "^connector-route:sha256:[a-f0-9]{64}$"
    },
    "capability_route_ref": {
      "type": "string",
      "pattern": "^capability-route:sha256:[a-f0-9]{64}$"
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "injection_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_trust": {
      "enum": [
        "NO_INJECTION_SIGNAL",
        "UNTRUSTED_PAGE_DATA"
      ]
    }
  }
}
