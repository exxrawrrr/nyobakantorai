{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/connector-grant-v2.schema.json",
  "title": "nyobakantorai Connector Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grant_id",
    "employee_id",
    "connector_id",
    "capability_id",
    "access_modes",
    "actions",
    "resources",
    "issued_at",
    "expires_at",
    "revoked_at",
    "evidence_ref",
    "revocation_evidence_ref",
    "grant_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "employee_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "access_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "READ",
          "WRITE"
        ]
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_type",
          "resource_id"
        ],
        "properties": {
          "resource_type": {
            "type": "string",
            "minLength": 1
          },
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\\\*"
            }
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "revocation_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "grant_ref": {
      "type": "string",
      "pattern": "^connector-grant:sha256:[a-f0-9]{64}$"
    }
  }
}
