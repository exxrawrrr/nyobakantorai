{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/project-memory-record.schema.json",
  "title": "nyobakantorai Project Brain Memory Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "scope",
    "knowledge_type",
    "content",
    "confidence",
    "created_at",
    "expires_at",
    "retention",
    "owner",
    "project_id",
    "shared_scope",
    "source_refs",
    "evidence_refs",
    "sensitivity",
    "provenance",
    "promotion",
    "supersedes",
    "record_sha256",
    "record_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "scope": {
      "enum": [
        "PRIVATE",
        "PROJECT",
        "APPROVED_SHARED"
      ]
    },
    "knowledge_type": {
      "enum": [
        "DECISION",
        "FACT",
        "ASSUMPTION",
        "FAILURE",
        "PREFERENCE",
        "TERMINOLOGY",
        "ARTIFACT",
        "LESSON"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retention": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "EMPLOYEE",
            "HUMAN"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "shared_scope": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "sensitivity": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "PRIVATE",
        "SECRET_PROHIBITED"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "created_by",
        "origin_refs",
        "parent_record_refs"
      ],
      "properties": {
        "origin": {
          "enum": [
            "MISSION",
            "TASK",
            "ARTIFACT",
            "USER",
            "IMPORT",
            "LEARNING_EVENT",
            "OTHER"
          ]
        },
        "created_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "origin_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "parent_record_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^memory:sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "promotion": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from_scope",
            "from_record_ref",
            "approved_by",
            "approved_at",
            "reason"
          ],
          "properties": {
            "from_scope": {
              "enum": [
                "PRIVATE",
                "PROJECT",
                "APPROVED_SHARED"
              ]
            },
            "from_record_ref": {
              "type": "string",
              "pattern": "^memory:sha256:[a-f0-9]{64}$"
            },
            "approved_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^memory:sha256:[a-f0-9]{64}$"
      }
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_ref": {
      "type": "string",
      "pattern": "^memory:sha256:[a-f0-9]{64}$"
    }
  }
}
