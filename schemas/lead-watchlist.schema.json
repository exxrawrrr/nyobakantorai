{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/lead-watchlist.schema.json",
  "title": "nyobakantorai Lead Watchlist v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "watchlist_id",
    "created_at",
    "interval_days",
    "entries",
    "budget",
    "raw_provider_content_persisted",
    "completeness_claim",
    "watchlist_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "watchlist_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "interval_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500
    },
    "budget": {
      "type": "object"
    },
    "raw_provider_content_persisted": {
      "const": false
    },
    "completeness_claim": {
      "const": false
    },
    "watchlist_ref": {
      "type": "string",
      "pattern": "^lead-watchlist:sha256:[a-f0-9]{64}$"
    }
  }
}
