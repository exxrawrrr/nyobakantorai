{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/geo-expansion-plan.schema.json",
  "title": "nyobakantorai Geo Expansion Plan v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "mission_id",
    "created_at",
    "queries",
    "completeness_claim",
    "adaptive_expansion_requires_review",
    "claim_boundary",
    "plan_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "queries": {
      "type": "array",
      "minItems": 1
    },
    "completeness_claim": {
      "const": false
    },
    "adaptive_expansion_requires_review": {
      "const": true
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^geo-expansion-plan:sha256:[a-f0-9]{64}$"
    }
  }
}
