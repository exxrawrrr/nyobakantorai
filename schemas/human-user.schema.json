{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human User",
  "type": "object",
  "required": ["schema","user_id","display_name","status","user_ref"],
  "properties": {
    "schema": {"const": 1},
    "user_id": {"type": "string", "pattern": "^user-[a-z0-9][a-z0-9-]{1,74}$"},
    "display_name": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACTIVE","SUSPENDED","REVOKED"]},
    "user_ref": {"type": "string", "pattern": "^human-user:sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
