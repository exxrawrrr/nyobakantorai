{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/recovery-policy.schema.json",
  "title": "nyobakantorai Recovery Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "max_attempts_per_task",
    "max_recovery_cycles",
    "retryable_error_categories",
    "provider_fallbacks",
    "browser"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "max_attempts_per_task": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "max_recovery_cycles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "retryable_error_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "provider_fallbacks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "reuse_user_profile_forbidden",
        "max_session_restarts"
      ],
      "properties": {
        "strategy": {
          "const": "NEW_ISOLATED_SESSION"
        },
        "reuse_user_profile_forbidden": {
          "const": true
        },
        "max_session_restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}
