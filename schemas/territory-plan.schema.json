{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/territory-plan.schema.json",
  "title": "nyobakantorai Territory Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission_id",
    "map_mission_ref",
    "territories",
    "completeness_claim",
    "provider_location_retention_respected",
    "territory_plan_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "map_mission_ref": {
      "type": "string",
      "minLength": 1
    },
    "territories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25
    },
    "completeness_claim": {
      "const": false
    },
    "provider_location_retention_respected": {
      "const": true
    },
    "territory_plan_ref": {
      "type": "string",
      "pattern": "^territory-plan:sha256:[a-f0-9]{64}$"
    }
  }
}
