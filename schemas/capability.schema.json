{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/capability.schema.json",
  "title": "nyobakantorai capability catalog",
  "type": "object",
  "required": ["schema", "generated", "generated_from", "taxonomy", "capabilities"],
  "properties": {
    "schema": { "const": 1 },
    "generated": { "const": true },
    "generated_from": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "taxonomy": { "type": "object" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "description", "source_refs", "usage_mode", "default_state", "risk_class", "required_by", "optional_for", "platforms", "install_method", "verification_method", "artifact_ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["skill","tool","mcp","plugin","extension","workflow","memory","hook","adapter","policy"] },
          "description": { "type": "string", "minLength": 1 },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "source_commit", "license"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1 },
                "source_commit": { "type": ["string","null"] },
                "license": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "usage_mode": { "type": "string", "minLength": 1 },
          "default_state": { "enum": ["BUNDLED","NOT_INSTALLED","REFERENCE_ONLY","NOT_CONNECTED"] },
          "risk_class": { "enum": ["PROCEDURAL","READ_ONLY","EXTERNAL_WRITE","PAID_ACTION","ACCOUNT_CHANGE","DESTRUCTIVE","MEMORY"] },
          "required_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "optional_for": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["windows","linux","macos","unspecified"] }, "uniqueItems": true },
          "install_method": { "type": "string", "minLength": 1 },
          "verification_method": { "type": "string", "minLength": 1 },
          "artifact_ref": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
