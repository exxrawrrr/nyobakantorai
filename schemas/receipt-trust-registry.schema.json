{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/receipt-trust-registry.schema.json",
  "title": "nyobakantorai Receipt Trust Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry_id",
    "keys"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "public_key_pem",
          "status",
          "signer_identity",
          "key_owner",
          "generation_boundary",
          "storage_expectation",
          "valid_from",
          "valid_until",
          "runtime_provider_scope",
          "runtime_ref_prefixes",
          "revoked_at",
          "compromise_cutoff",
          "revocation_reason",
          "historical_policy"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "public_key_pem": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ACTIVE",
              "RETIRED",
              "REVOKED"
            ]
          },
          "signer_identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "key_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "generation_boundary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "storage_expectation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "runtime_provider_scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "runtime_ref_prefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "compromise_cutoff": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "revocation_reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "historical_policy": {
            "enum": [
              "ALLOW_WITHIN_VALIDITY",
              "REJECT_ALL",
              "ALLOW_PRE_COMPROMISE"
            ]
          }
        }
      }
    }
  }
}
