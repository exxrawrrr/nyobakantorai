{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/geo-export-pack.schema.json",
  "title": "nyobakantorai Geo Research Export Pack v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "created_at",
    "plan_ref",
    "profile_refs",
    "score_refs",
    "verification_refs",
    "evidence_pack_ref",
    "completeness_claim",
    "pack_ref",
    "files"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "profile_refs": {
      "type": "array",
      "minItems": 1
    },
    "score_refs": {
      "type": "array",
      "minItems": 1
    },
    "verification_refs": {
      "type": "array"
    },
    "evidence_pack_ref": {
      "type": "string",
      "pattern": "^geo-evidence-pack:sha256:[a-f0-9]{64}$"
    },
    "completeness_claim": {
      "const": false
    },
    "pack_ref": {
      "type": "string",
      "pattern": "^geo-export-pack:sha256:[a-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "required": [
        "profiles.csv",
        "profiles.xlsx",
        "report.md",
        "evidence.json"
      ]
    }
  }
}
