{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/mission-handoff.schema.json",
  "title": "nyobakantorai Mission Handoff Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "mission_id",
    "task_id",
    "source",
    "destination_employee_id",
    "objective",
    "constraints",
    "required_evidence",
    "input_artifact_refs",
    "budget",
    "risk_class",
    "allowed_capabilities",
    "required_skills",
    "timeout_ms",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "task_ids",
        "employee_ids"
      ],
      "properties": {
        "kind": {
          "const": "MISSION_ORCHESTRATOR"
        },
        "task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "employee_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          }
        }
      }
    },
    "destination_employee_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "required_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "input_artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_limit_amount",
        "currency"
      ],
      "properties": {
        "hard_limit_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "risk_class": {
      "enum": [
        "READ_ONLY",
        "LOCAL_WRITE",
        "EXTERNAL_WRITE",
        "PAID_ACTION",
        "ACCOUNT_CHANGE",
        "DESTRUCTIVE"
      ]
    },
    "allowed_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "required_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 45000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
