{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/approval-decision-v2.schema.json",
  "title": "nyobakantorai Approval Decision v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "approval_ref",
    "decision",
    "actor",
    "decided_at",
    "expires_at",
    "scope",
    "edited_preview",
    "evidence_ref",
    "decision_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "approval_ref": {
      "type": "string",
      "pattern": "^approval-request:sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "APPROVED",
        "EDITED",
        "REJECTED"
      ]
    },
    "actor": {
      "const": "owner"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object"
    },
    "edited_preview": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "decision_ref": {
      "type": "string",
      "pattern": "^approval-decision:sha256:[a-f0-9]{64}$"
    }
  }
}
