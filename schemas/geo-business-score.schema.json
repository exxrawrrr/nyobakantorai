{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/geo-business-score.schema.json",
  "title": "nyobakantorai Explainable Geo Business Score v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_ref",
    "model_id",
    "model_version",
    "score",
    "max_score",
    "contributions",
    "final_status",
    "explainable",
    "score_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "max_score": {
      "const": 100
    },
    "contributions": {
      "type": "array",
      "minItems": 1
    },
    "final_status": {
      "const": "PENDING_VERIFICATION"
    },
    "explainable": {
      "const": true
    },
    "score_ref": {
      "type": "string",
      "pattern": "^geo-business-score:sha256:[a-f0-9]{64}$"
    }
  }
}
