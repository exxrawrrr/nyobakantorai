{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/live-sandbox-policy.schema.json",
  "title": "nyobakantorai Live Sandbox Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "allowed_risk_classes",
    "max_duration_ms",
    "max_tool_calls",
    "max_input_tokens",
    "max_output_tokens",
    "max_total_tokens",
    "max_cost_usd",
    "allowed_tool_ids",
    "allowed_network_hosts",
    "allowed_runtime_providers",
    "allow_fallback",
    "require_temporary_workspace",
    "forbid_external_write",
    "forbid_credentials_exposure"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,119}$"
    },
    "note": {
      "type": "string"
    },
    "allowed_risk_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "READ_ONLY",
          "LOCAL_WRITE",
          "EXTERNAL_WRITE",
          "PAID_ACTION",
          "ACCOUNT_CHANGE",
          "DESTRUCTIVE"
        ]
      }
    },
    "max_duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 45000
    },
    "max_tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "max_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "max_total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "max_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "allowed_tool_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_network_hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_runtime_providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allow_fallback": {
      "type": "boolean"
    },
    "require_temporary_workspace": {
      "const": true
    },
    "forbid_external_write": {
      "const": true
    },
    "forbid_credentials_exposure": {
      "const": true
    }
  }
}
