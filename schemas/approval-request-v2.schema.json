{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/approval-request-v2.schema.json",
  "title": "nyobakantorai Approval Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "approval_id",
    "target",
    "risk_class",
    "budget",
    "reason",
    "evidence_refs",
    "preview",
    "scope",
    "requested_at",
    "expires_at",
    "status",
    "approval_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "risk_class": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preview": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "resources"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\\\*"
            }
          }
        }
      }
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "PENDING"
    },
    "approval_ref": {
      "type": "string",
      "pattern": "^approval-request:sha256:[a-f0-9]{64}$"
    }
  }
}
