{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/cost-governor-policy.schema.json",
  "title": "nyobakantorai Cost Governor Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "currency",
    "thresholds",
    "daily_limit_amount",
    "project_limits",
    "mission_limits",
    "employee_limits"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warning_ratio",
        "reroute_ratio",
        "approval_ratio"
      ],
      "properties": {
        "warning_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "reroute_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "approval_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "daily_limit_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "project_limits": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      }
    },
    "mission_limits": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      }
    },
    "employee_limits": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      }
    }
  }
}
