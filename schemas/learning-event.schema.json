{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/learning-event.schema.json",
  "title": "nyobakantorai learning event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "employee_id",
    "layer",
    "created_at",
    "summary",
    "evidence_refs",
    "source_refs",
    "sensitivity"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "employee_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "layer": {
      "enum": [
        "M1",
        "M2",
        "M3",
        "M4"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "sensitivity": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "PRIVATE",
        "SECRET_PROHIBITED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "shared_scope": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "human_review": {
      "type": "boolean"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layer": {
            "const": "M3"
          }
        },
        "required": [
          "layer"
        ]
      },
      "then": {
        "required": [
          "shared_scope",
          "human_review",
          "reviewed_by"
        ],
        "properties": {
          "shared_scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "human_review": {
            "const": true
          },
          "reviewed_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layer": {
            "const": "M4"
          }
        },
        "required": [
          "layer"
        ]
      },
      "then": {
        "required": [
          "human_review"
        ],
        "properties": {
          "human_review": {
            "const": true
          }
        }
      }
    }
  ]
}
