{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/mission-plan.schema.json",
  "title": "nyobakantorai Mission Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "strategy",
    "mission",
    "task_nodes",
    "node_meta",
    "graph",
    "assumptions",
    "unknowns",
    "generated_at"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "strategy": {
      "enum": [
        "RULE_BASED_V1",
        "EXPLICIT_WORK_ITEMS",
        "COORDINATOR_FALLBACK"
      ]
    },
    "mission": {
      "type": "object"
    },
    "task_nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "node_meta": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "key",
          "depends_on",
          "constraints",
          "required_skills",
          "required_evidence",
          "budget_policy",
          "route"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "constraints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required_skills": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "budget_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "hard_limit_amount",
              "currency"
            ],
            "properties": {
              "source": {
                "const": "MISSION_SHARED"
              },
              "hard_limit_amount": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "route": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "employee",
              "source",
              "score",
              "reasons",
              "factors"
            ],
            "properties": {
              "employee": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,39}$"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "reasons": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "factors": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "task_ids",
        "edges",
        "topological_layers",
        "parallel_groups",
        "roots",
        "leaves"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "topological_layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "parallel_groups": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "leaves": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "unknowns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
