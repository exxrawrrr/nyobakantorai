{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/crm-ready-export.schema.json",
  "title": "nyobakantorai CRM Ready Export v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "created_at",
    "lead_count",
    "candidate_refs",
    "verification_refs",
    "evidence_ref",
    "external_write_state",
    "outreach_included",
    "completeness_claim",
    "crm_export_ref",
    "files"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "lead_count": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 1
    },
    "verification_refs": {
      "type": "array",
      "minItems": 1
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^crm-export-evidence:sha256:[a-f0-9]{64}$"
    },
    "external_write_state": {
      "const": "NOT_WRITTEN"
    },
    "outreach_included": {
      "const": false
    },
    "completeness_claim": {
      "const": false
    },
    "crm_export_ref": {
      "type": "string",
      "pattern": "^crm-ready-export:sha256:[a-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "required": [
        "crm-leads.csv",
        "crm-leads.xlsx",
        "crm-evidence.json"
      ]
    }
  }
}
