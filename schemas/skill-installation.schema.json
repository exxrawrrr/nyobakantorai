{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/skill-installation.schema.json",
  "title": "nyobakantorai Skill Installation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "skill_id",
    "version",
    "content_sha256",
    "source_refs",
    "installed_by",
    "installed_at",
    "evidence_ref",
    "authority_effect",
    "install_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,99}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "installed_by": {
      "const": "owner"
    },
    "installed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "NONE"
    },
    "install_ref": {
      "type": "string",
      "pattern": "^skill-install:sha256:[a-f0-9]{64}$"
    }
  }
}
