{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/competitor-radar.schema.json",
  "title": "nyobakantorai Competitor Radar v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_at",
    "rows",
    "verified_only",
    "completeness_claim",
    "radar_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "rows": {
      "type": "array"
    },
    "verified_only": {
      "const": true
    },
    "completeness_claim": {
      "const": false
    },
    "radar_ref": {
      "type": "string",
      "pattern": "^competitor-radar:sha256:[a-f0-9]{64}$"
    }
  }
}
