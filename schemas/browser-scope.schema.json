{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/exxrawrrr/nyobakantorai/schemas/browser-scope.schema.json",
  "title": "nyobakantorai Browser Scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "employee_id",
    "flow",
    "allowed_origins",
    "ownership_evidence_ref",
    "issued_at",
    "expires_at",
    "scope_ref"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "employee_id": {
      "type": "string",
      "minLength": 1
    },
    "flow": {
      "enum": [
        "PUBLIC_RESEARCH",
        "USER_OWNED_AUDIT",
        "LOCALHOST_QA"
      ]
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "ownership_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "scope_ref": {
      "type": "string",
      "pattern": "^browser-scope:sha256:[a-f0-9]{64}$"
    }
  }
}
